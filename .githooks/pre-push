#!/usr/bin/env bash
# Runs the test suite before allowing a push. Enabled via:
#   git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: dotnet test"
if ! dotnet test Tk.Tests/Tk.Tests.csproj --nologo --verbosity quiet; then
    echo "pre-push: tests failed — aborting push" >&2
    exit 1
fi
